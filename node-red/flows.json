  {
    "id": "dbg_tel",
    "type": "debug",
    "name": "telemetry",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "payload.temp",
    "statusType": "msg",
    "z": "tab_ac",
    "x": 330,
    "y": 100,
    "wires": []
  },
  {
    "id": "fn_split",
    "type": "function",
    "name": "Parse telemetry",
    "func": "// Split the JSON telemetry into one message per widget\nconst d = msg.payload;\nif (typeof d !== 'object' || d === null) return null;\n\nconst last = context.get('last') || {};\n// re-sync the controls when a value changes, and every 5 messages (page reloads)\nconst n = (context.get('n') || 0) + 1; context.set('n', n);\nconst changed = (k) => { const c = last[k] !== d[k] || n % 5 === 0; last[k] = d[k]; return c; };\n\nconst fanTxt = ['OFF', 'LOW', 'MEDIUM', 'HIGH'][d.fan] || '-';\nconst icons = { COOLING: '❄️ COOLING', HEATING: '🔥 HEATING', IDLE: '⏸️ IDLE (setpoint reached)',\n                FAN: '🌀 FAN ONLY', OFF: '⛔ OFF' };\n\nconst out = [\n  { payload: d.temp },                                       // 1 temp gauge\n  { payload: d.hum },                                        // 2 humidity gauge\n  [ { topic: 'Room temperature', payload: d.temp },          // 3 chart\n    { topic: 'Setpoint', payload: d.setpoint } ],\n  { payload: icons[d.state] || d.state },                    // 4 state text\n  { payload: fanTxt },                                       // 5 fan text\n  changed('power')    ? { payload: d.power }    : null,      // 6 sync power switch\n  changed('mode')     ? { payload: d.mode }     : null,      // 7 sync mode buttons\n  changed('setpoint') ? { payload: d.setpoint } : null,      // 8 sync slider\n  null                                                       // 9 alert\n];\n\n// High temperature alert (only on transition)\nconst hot = d.temp >= 35;\nif (hot && !context.get('hot')) out[8] = { payload: '⚠️ Room temperature is ' + d.temp + ' °C !' };\ncontext.set('hot', hot);\ncontext.set('last', last);\nreturn out;",
    "outputs": 9,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "outputLabels": [
      "temperature",
      "humidity",
      "chart",
      "state",
      "fan",
      "power",
      "mode",
      "setpoint",
      "alert"
    ],
    "z": "tab_ac",
    "x": 340,
    "y": 220,
    "wires": [
      [
        "g_temp"
      ],
      [
        "g_hum"
      ],
      [
        "chart"
      ],
      [
        "t_state"
      ],
      [
        "t_fan"
      ],
      [
        "sw_power"
      ],
